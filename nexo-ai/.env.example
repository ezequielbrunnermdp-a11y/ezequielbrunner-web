# Postgres / Supabase connection string. If empty, an embedded Postgres (PGlite)
# is stored in ./.data for local development.
DATABASE_URL=

# 32-byte key, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXO_ENCRYPTION_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
NEXO_CLAUDE_MODEL=claude-opus-5-5
