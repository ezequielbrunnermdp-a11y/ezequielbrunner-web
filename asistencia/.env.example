# Conexión a PostgreSQL (Supabase: usar la cadena "Session pooler" o directa, con sslmode=require)
DATABASE_URL=postgres://asis:asis@localhost:5432/asistencia
# Habilitar SSL en la conexión a la base (true en Supabase / cloud)
DATABASE_SSL=false

# URL pública de la app (HTTPS obligatorio en producción)
APP_URL=http://localhost:3000

# Secretos: generar con `openssl rand -base64 48`. NUNCA commitear valores reales.
QR_SIGNING_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
CRON_SECRET=cambiar-por-otro-secreto

# Duración de la sesión (horas)
SESSION_TTL_HOURS=12

# Correo: "log" (sólo consola), "resend" o "smtp-webhook"
EMAIL_PROVIDER=log
EMAIL_FROM="Asistencia <asistencia@tu-dominio.com>"
RESEND_API_KEY=

# QR: segundos de vigencia de cada código mostrado en la terminal
QR_TTL_SECONDS=45
