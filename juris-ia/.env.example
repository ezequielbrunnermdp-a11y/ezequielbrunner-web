# --- Base de datos (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql://juris:juris@localhost:5432/juris

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# Modelo por defecto: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Almacenamiento privado y cifrado de documentos ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
STORAGE_DIR=./storage

# --- Búsqueda semántica (opcional) ---
# Sin clave, la recuperación es léxica (full-text en español + trigramas).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Jurisprudencia: búsqueda web de Claude restringida a dominios oficiales (opcional) ---
# Requiere que la organización de Anthropic tenga habilitada la herramienta web_search.
JURISPRUDENCIA_WEB_SEARCH=false
