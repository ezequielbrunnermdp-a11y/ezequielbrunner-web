# Copiar como .env.local (desarrollo) o configurar en Netlify > Site configuration > Environment variables.
# Solo claves PÚBLICAS: la anon key está pensada para el navegador y depende de RLS.
# NUNCA colocar la service_role key en el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Opcional: clave pública VAPID para notificaciones push (ver docs/NOTIFICACIONES.md)
VITE_VAPID_PUBLIC_KEY=
